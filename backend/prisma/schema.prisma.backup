// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────
enum UserType {
  STUDENT_EXPLORER
  PLACEMENT_PREP
  JUNIOR_PROFESSIONAL
}

enum Plan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum EmployeeRole {
  ADMIN
  CONTENT_DEVELOPER
}

enum DifficultyLevel {
  FOUNDATIONAL
  INTERMEDIATE
  ADVANCED
}

enum SimulationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MessageType {
  CHAT
  EMAIL
  SLACK
  WHATSAPP
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PerformanceLevel {
  EXCELLENT
  GREAT
  GOOD
  AVERAGE
  BELOW_PAR
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ── Models ───────────────────────────────────────────────────────────────────

model Employee {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String
  role               EmployeeRole @default(CONTENT_DEVELOPER)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt @default(now())

  createdSimulations Simulation[] @relation("Creator")

  @@map("employees")
}

model EmailVerification {
  id         String   @id @default(uuid())
  email      String
  otpCode    String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email])
  @@map("email_verifications")
}

model Domain {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconName    String   @default("BookOpen")
  colorHex    String   @default("#5a7f2e")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  simulations      Simulation[]
  users            User[]            @relation("SelectedDomain")
  dimensionConfigs DimensionConfig[] @relation("DomainDimensionConfigs")

  @@map("domains")
}

model User {
  id String @id @default(uuid())

  // ✅ NEW: Split name fields for signup
  firstName  String
  middleName String?
  lastName   String

  // ✅ Phone for government-registered unique ID
  phone           String  @unique
  isPhoneVerified Boolean @default(false)

  // ✅ Gender
  gender Gender?

  // ✅ Existing fields
  email            String    @unique
  passwordHash     String
  linkedinUrl      String?
  isEmailVerified  Boolean   @default(false)
  isActive         Boolean   @default(true)
  plan             Plan      @default(FREE)
  userType         UserType?
  selectedDomainId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt @default(now())

  // ✅ Bidirectional relations (corrected)
  selectedDomain     Domain?             @relation("SelectedDomain", fields: [selectedDomainId], references: [id])
  profile            UserProfile?
  subscription       Subscription?
  sessions           SimulationSession[]
  badges             SimulationBadge[]
  diagnosticSessions DiagnosticSession[]
  // ❌ REMOVED: createdSimulations (Simulation.createdBy is Employee, not User)

  @@index([email])
  @@index([phone])
  @@index([selectedDomainId])
  @@map("users")
}

model UserProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  collegeName    String?
  graduationYear Int?
  city           String?
  bio            String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  planType  Plan               @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model Simulation {
  id                 String           @id @default(uuid())
  domainId           String
  createdBy          String
  title              String
  slug               String           @unique
  description        String
  difficultyLevel    DifficultyLevel  @default(FOUNDATIONAL)
  userTypeTarget     UserType?
  estimatedMinutes   Int              @default(30)
  totalQuestions     Int              @default(25)
  openingScene       String?
  isPremium          Boolean          @default(false)
  isPublished        Boolean          @default(false)
  status             SimulationStatus @default(DRAFT)
  sortOrder          Int              @default(0)
  sequenceOrder      Int?
  isDiagnosticSource Boolean          @default(false)
  isDeleted          Boolean          @default(false)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt @default(now())
  actConfig          Json?

  // Relations
  actNarratives      ActNarrative[]
  conversations      Conversation[]
  decisions          Decision[]
  diagnosticSessions DiagnosticSession[]
  gradeBands         GradeBandDescription[]
  scoringDimensions  ScoringDimensionConfig[]
  characters         SimulationCharacter[]
  endings            SimulationEnding[]
  sessions           SimulationSession[]
  tags               SimulationTag[]
  variables          SimulationVariable[]
  versions           SimulationVersion[]
  variableInsights   VariableInsight[]

  // Foreign keys
  creator Employee      @relation("Creator", fields: [createdBy], references: [id])
  domain  Domain        @relation(fields: [domainId], references: [id])
  story   StorySection?

  @@index([domainId])
  @@index([status])
  @@index([isPublished, isDeleted])
  @@map("simulations")
}

model SimulationVersion {
  id            String   @id @default(uuid())
  simulationId  String
  versionNumber Int
  snapshot      Json
  changeNotes   String?
  isActive      Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, versionNumber])
  @@index([simulationId])
  @@map("simulation_versions")
}

model SimulationTag {
  id           String @id @default(uuid())
  simulationId String
  tag          String

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, tag])
  @@index([simulationId])
  @@map("simulation_tags")
}

model StorySection {
  id                     String   @id @default(uuid())
  simulationId           String   @unique
  companyBackground      String   @default("")
  closingChallenge       String?
  howItWorks             String?
  arrivalContext         String?
  incomingMessages       String?
  seniorStatement        String?
  reportTemplates        Json?
  seniorPerspectiveLines Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("story_sections")
}

model Character {
  id          String   @id @default(uuid())
  name        String
  role        String
  description String?
  avatarUrl   String?
  isPlayer    Boolean  @default(false)
  createdAt   DateTime @default(now())

  messages             Message[]
  simulationCharacters SimulationCharacter[]

  @@map("characters")
}

model SimulationCharacter {
  id             String  @id @default(uuid())
  simulationId   String
  characterId    String
  trustLevel     Int?
  emotionalState String?
  keyConcern     String?
  introText      String?
  introOrder     Int     @default(0)
  isPlayer       Boolean @default(false)

  character  Character  @relation(fields: [characterId], references: [id])
  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, characterId])
  @@index([simulationId])
  @@map("simulation_characters")
}

model Variable {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  unit        String   @default("%")
  createdAt   DateTime @default(now())

  simulationVariables SimulationVariable[]

  @@map("variables")
}

model SimulationVariable {
  id               String   @id @default(uuid())
  simulationId     String
  variableId       String
  variableName     String
  displayName      String
  startingValue    Float    @default(50)
  unit             String   @default("%")
  higherIsBetter   Boolean  @default(true)
  isVisible        Boolean  @default(true)
  scoringDimension String   @default("CUSTOM")
  dimensionWeight  Float    @default(1.0)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  impacts       OptionImpact[]
  sessionStates SessionVariableState[]
  simulation    Simulation             @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  variable      Variable               @relation(fields: [variableId], references: [id])

  @@index([simulationId])
  @@map("simulation_variables")
}

model Conversation {
  id             String    @id @default(uuid())
  simulationId   String
  title          String?
  userTypeTarget UserType?
  sequenceOrder  Int
  createdAt      DateTime  @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([simulationId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  characterId    String?
  messageType    MessageType @default(CHAT)
  content        String
  timestamp      String?
  metadata       Json?
  sequenceOrder  Int         @default(0)
  createdAt      DateTime    @default(now())

  character    Character?   @relation(fields: [characterId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Decision {
  id                String   @id @default(uuid())
  simulationId      String
  sequenceOrder     Int
  tag               String?
  weekLabel         String?
  charactersPresent String[]
  situationUpdate   String?
  questionText      String
  contextNote       String?
  isDiagnostic      Boolean  @default(false)
  diagnosticOrder   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())

  logs       DecisionLog[]
  simulation Simulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  options    Option[]

  @@unique([simulationId, sequenceOrder])
  @@index([simulationId])
  @@map("decisions")
}

model Option {
  id              String   @id @default(uuid())
  decisionId      String
  optionLabel     String
  title           String
  description     String
  strategyTag     String?
  consequenceText String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  logs     DecisionLog[]
  impacts  OptionImpact[]
  decision Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, optionLabel])
  @@index([decisionId])
  @@map("options")
}

model OptionImpact {
  id                   String   @id @default(uuid())
  optionId             String
  simulationVariableId String
  delta                Float
  createdAt            DateTime @default(now())

  option             Option             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  simulationVariable SimulationVariable @relation(fields: [simulationVariableId], references: [id], onDelete: Cascade)

  @@unique([optionId, simulationVariableId])
  @@index([optionId])
  @@map("option_impacts")
}

model SimulationEnding {
  id             String    @id @default(uuid())
  simulationId   String
  endingKey      String
  title          String
  condition      String
  narrative      String
  userTypeTarget UserType?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, endingKey])
  @@index([simulationId])
  @@map("simulation_endings")
}

model ScoringDimensionConfig {
  id               String   @id @default(uuid())
  simulationId     String
  dimensionKey     String
  displayName      String
  description      String   @default("")
  weight           Float    @default(1.0)
  bandDescriptions Json?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, dimensionKey])
  @@index([simulationId])
  @@map("scoring_dimension_configs")
}

model GradeBandDescription {
  id           String   @id @default(uuid())
  simulationId String
  grade        String
  userType     String
  description  String
  dimensionKey String
  createdAt    DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, dimensionKey, grade, userType])
  @@index([simulationId])
  @@map("grade_band_descriptions")
}

model ActNarrative {
  id           String   @id @default(uuid())
  simulationId String
  actNumber    Int
  gradePattern String
  message      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, actNumber, gradePattern])
  @@index([simulationId])
  @@map("act_narratives")
}

model VariableInsight {
  id           String   @id @default(uuid())
  simulationId String
  variableName String
  insightText  String
  createdAt    DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, variableName])
  @@index([simulationId])
  @@map("variable_insights")
}

model SimulationSession {
  id            String        @id @default(uuid())
  userId        String
  simulationId  String
  attemptNumber Int           @default(1)
  status        SessionStatus @default(IN_PROGRESS)
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt @default(now())

  result         AttemptResult?
  logs           DecisionLog[]
  variableStates SessionVariableState[]
  badge          SimulationBadge?

  simulation Simulation @relation(fields: [simulationId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([simulationId])
  @@index([userId, simulationId])
  @@map("simulation_sessions")
}

model SessionVariableState {
  id                   String   @id @default(uuid())
  sessionId            String
  simulationVariableId String
  currentValue         Float
  createdAt            DateTime @default(now())

  session            SimulationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  simulationVariable SimulationVariable @relation(fields: [simulationVariableId], references: [id])

  @@unique([sessionId, simulationVariableId])
  @@index([sessionId])
  @@map("session_variable_states")
}

model DecisionLog {
  id             String   @id @default(uuid())
  sessionId      String
  decisionId     String
  optionId       String
  decisionNumber Int
  createdAt      DateTime @default(now())

  decision Decision          @relation(fields: [decisionId], references: [id])
  option   Option            @relation(fields: [optionId], references: [id])
  session  SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, decisionId])
  @@index([sessionId])
  @@map("decision_logs")
}

model AttemptResult {
  id                    String           @id @default(uuid())
  sessionId             String           @unique
  overallScore          Int
  performanceLevel      PerformanceLevel
  resultSummary         String?
  financialPrudence     Float?
  stakeholderAlignment  Float?
  riskManagement        Float?
  leadershipCredibility Float?
  teamMorale            Float?
  strategicClarity      Float?
  customScores          Json?
  behavioralData        Json?
  createdAt             DateTime         @default(now())

  session    SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  breakdowns ResultBreakdown[]

  @@index([sessionId])
  @@map("attempt_results")
}

model ResultBreakdown {
  id                   String   @id @default(uuid())
  resultId             String
  simulationVariableId String
  finalValue           Float
  weight               Float    @default(1.0)
  contributionScore    Float
  createdAt            DateTime @default(now())

  result AttemptResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("result_breakdowns")
}

model SimulationBadge {
  id             String    @id @default(uuid())
  userId         String
  sessionId      String    @unique
  simulationId   String?
  badgeType      String
  grade          String?
  earnedAt       DateTime  @default(now())
  linkedInShared Boolean   @default(false)
  sharedAt       DateTime?
  createdAt      DateTime  @default(now())

  session SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("simulation_badges")
}

model DiagnosticSession {
  id           String    @id @default(uuid())
  guestToken   String    @unique
  userId       String?
  simulationId String
  answers      Json
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  @@index([guestToken])
  @@index([simulationId])
  @@map("diagnostic_sessions")
}

// ✅ DimensionConfig - preserved exactly to avoid data loss
model DimensionConfig {
  id           String   @id @default(uuid())
  domainId     String
  userType     UserType
  dimensionKey String
  displayName  String
  description  String?  @default("")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  domain Domain @relation("DomainDimensionConfigs", fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, userType, dimensionKey])
  @@index([domainId])
  @@map("dimension_config")
}