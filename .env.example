# ─────────────────────────────────────────
# ManaGenz Backend — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ── SERVER ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── DATABASE (Railway PostgreSQL) ────────
# Get this from Railway → your project → PostgreSQL → Connect
# Use direct connection string (not pooler) for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── JWT (Student Auth) ───────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# ── ADMIN JWT (separate from student JWT) ───────────
# Used for admin_token and emp_token cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_SECRET="your-super-secret-admin-jwt-key-change-this"
ADMIN_EMAIL="admin@managenz.com"
ADMIN_PASSWORD="change-this-in-production"

# ── FRONTEND URL (for CORS) ──────────────
FRONTEND_URL="http://localhost:3000"
# In production: FRONTEND_URL="https://managenz.vercel.app"

# ── EMAIL (Resend) ───────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@managenz.com"

# ── PAYMENTS (Razorpay) ──────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# ── CLOUDINARY (Audio/Image Storage) ────
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── GOOGLE OAUTH (Optional) ──────────────
# Get from: console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── LOGGING (Optional) ───────────────────
LOG_LEVEL=info
# Set to true to log Prisma queries in development (verbose)
ENABLE_PRISMA_LOGGING=false

# ── RATE LIMITS (Optional overrides) ─────
# Global rate limit: max requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
# Auth route rate limit: stricter for login attempts
AUTH_RATE_LIMIT_MAX=20

# ── COOKIE SETTINGS (Do not change without updating frontend) ─
# Cookie names used for auth tokens
STUDENT_COOKIE_NAME=managenz_token
ADMIN_COOKIE_NAME=admin_token
EMPLOYEE_COOKIE_NAME=emp_token
# Cookie security settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=28800000